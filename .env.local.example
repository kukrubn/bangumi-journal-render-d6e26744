# Supabase 项目设置中的 Project URL 与 Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 把前缀替换为实际开发者 ID，例如 alice/bangumi-journal/0.4.0
BANGUMI_USER_AGENT=

# 独立开发者账号（可选）。Windows 本机由 account:setup 生成以下服务端配置。
# Vercel 部署时沿用账号、所有者 UUID 与密码哈希，为生产单独生成会话密钥。
JOURNAL_DEV_EMAIL=
JOURNAL_DEV_OWNER=
JOURNAL_DEV_PASSWORD_HASH=
JOURNAL_DEV_JWT_SECRET=
# 云端 PostgreSQL 的受限运行角色连接串，仅服务端使用。Neon 支持连接池端点。
JOURNAL_DATABASE_URL=
# 本机或自管 PostgREST 使用以下两项。
JOURNAL_DEV_REST_URL=
JOURNAL_DEV_GATEWAY_KEY=
